# Vast.ai Serverless GPU worker image
# Build: go-task vastai-build
#
# Uses python:3.11-slim instead of nvidia/cuda base image.
# CUDA runtime comes from pip packages (nvidia-cudnn-cu12 etc.).
# The NVIDIA driver is provided by the host via nvidia-container-toolkit.

# Stage 1: Install Python deps into venv (single layer for smaller image)
FROM docker.io/python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

RUN python -m venv /opt/venv

# All deps in single RUN for fewer layers + smaller image
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python /opt/venv/bin/python --no-cache-dir \
    onnxruntime-gpu==1.24.4 \
    nvidia-cublas-cu12 \
    nvidia-cuda-runtime-cu12 \
    nvidia-cudnn-cu12 \
    nvidia-curand-cu12 \
    nvidia-cufft-cu12 \
    nvidia-cusolver-cu12 \
    nvidia-cusparse-cu12 \
    nvidia-cuda-nvcc-cu12 \
    opencv-python-headless==4.10.0.84 \
    "numpy>=1.24,<2.3" \
    scipy==1.17.1 \
    numba==0.61.2 \
    fastapi==0.135.2 \
    "uvicorn[standard]==0.42.0" \
    python-multipart==0.0.22 \
    structlog==25.5.0 \
    pydantic-settings==2.13.1 \
    boto3==1.42.80 \
    httpx==0.28.1 \
    prometheus-client==0.22.1 \
    aiobotocore==3.4.0 \
    vastai==1.0.8 \
    # Strip: __pycache__, .pyc/.pyo, tests (keep numpy/_core/tests), pip, setuptools, debug symbols
    && find /opt/venv -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null; \
    find /opt/venv -type f -name "*.pyc" -delete 2>/dev/null; \
    find /opt/venv -type f -name "*.pyo" -delete 2>/dev/null; \
    find /opt/venv -path "*/site-packages/*/tests" -not -path "*/numpy/*" -exec rm -rf {} + 2>/dev/null; \
    rm -rf /opt/venv/lib/python3.11/site-packages/pip \
    /opt/venv/lib/python3.11/site-packages/setuptools; \
    find /opt/venv -type f -name "*.so*" -exec strip --strip-debug {} + 2>/dev/null; \
    true

# Stage 2: model download
# Uses Docker secrets for pre-signed URLs (not in image metadata)
# Uses cache mount to persist model files across builds
FROM docker.io/python:3.11-slim AS model_fetch

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Secret files containing pre-signed URLs (one URL per file)
# Cache mount persists downloads across builds — no re-download on URL rotation
# All models are FP16 (half VRAM, <1mm MPJPE increase)
RUN --mount=type=secret,id=moganet_url \
    --mount=type=secret,id=yolo_url \
    --mount=type=secret,id=tcpformer_url \
    --mount=type=cache,target=/model-cache \
    mkdir -p /models/moganet /models/tcpformer && \
    MOGANET_URL=$(cat /run/secrets/moganet_url) && \
    if [ ! -f /model-cache/moganet_b_fp16.onnx ]; then \
      curl -sS --fail -o /model-cache/moganet_b_fp16.onnx "$MOGANET_URL"; \
    fi && \
    cp /model-cache/moganet_b_fp16.onnx /models/moganet/moganet_b_ap2d_384x288_fp16.onnx && \
    YOLO_URL=$(cat /run/secrets/yolo_url) && \
    if [ ! -f /model-cache/rf_detr_nano_fp16.onnx ]; then \
      curl -sS --fail -o /model-cache/rf_detr_nano_fp16.onnx "$YOLO_URL"; \
    fi && \
    cp /model-cache/rf_detr_nano_fp16.onnx /models/ && \
    TCPFORMER_URL=$(cat /run/secrets/tcpformer_url) && \
    if [ ! -f /model-cache/tcpformer_fp16.onnx ]; then \
      curl -sS --fail -o /model-cache/tcpformer_fp16.onnx "$TCPFORMER_URL"; \
    fi && \
    cp /model-cache/tcpformer_fp16.onnx /models/tcpformer/TCPFormer_ap3d_81_fp16.onnx

# Stage 3: Minimal runtime
FROM docker.io/python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Non-root user
RUN groupadd -r appuser -g 1000 && \
    useradd -r -u 1000 -g appuser -m -d /home/appuser appuser

# Copy venv from builder
COPY --from=builder --chown=appuser:appuser /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" \
    PROJECT_ROOT=/app \
    VIRTUAL_ENV=/opt/venv \
    WORKER_PORT=5000 \
    MODEL_LOG_FILE=/tmp/skatelab-server.log \
    LD_LIBRARY_PATH="/opt/venv/lib/python3.11/site-packages/nvidia/cublas/lib:/opt/venv/lib/python3.11/site-packages/nvidia/cuda_runtime/lib:/opt/venv/lib/python3.11/site-packages/nvidia/cudnn/lib:/opt/venv/lib/python3.11/site-packages/nvidia/curand/lib:/opt/venv/lib/python3.11/site-packages/nvidia/cufft/lib:/opt/venv/lib/python3.11/site-packages/nvidia/cusolver/lib:/opt/venv/lib/python3.11/site-packages/nvidia/cusparse/lib:/opt/venv/lib/python3.11/site-packages/nvidia/cuda_nvcc/lib"

# ONNX models copied from model_fetch stage
RUN mkdir -p /app/data/models && chown appuser:appuser /app /app/data /app/data/models
COPY --from=model_fetch --chown=appuser:appuser /models/ /app/data/models/

# Source code — changes most often, top layer
COPY --chown=appuser:appuser ml/src/ src/
COPY --chown=appuser:appuser ml/gpu_server/ gpu_server/

USER appuser

EXPOSE 5000 8000

CMD ["bash", "gpu_server/start_server.sh"]