# Dokploy ClickHouse service env.
# NOTE: spec finding #29 — ClickHouse NOT currently deployed in /opt/infra/compose.yaml.
# Only create this service in Dokploy if/when ClickHouse is actually needed.
CLICKHOUSE_DB=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=__FROM_DOKPLOY_SECRETS__
CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1