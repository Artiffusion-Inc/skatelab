# PostHog — copy to .env.posthog and fill in values
# Used by docker-compose.override.yml

# ── App version ──
POSTHOG_APP_TAG=1.88.0
POSTHOG_SECRET_KEY=change-me-to-random-64-chars

# ── Shared infrastructure (Valkey DB 2, RustFS) ──
RUSTFS_ACCESS_KEY_ID=<rustfs-key>
RUSTFS_SECRET_ACCESS_KEY=<rustfs-secret>

# ── PostgreSQL (PG 15 container, port 5433 on host) ──
POSTHOG_POSTGRES_HOST=db
POSTHOG_POSTGRES_PASSWORD=change-me
POSTHOG_POSTGRES_DB=posthog
POSTHOG_POSTGRES_USER=posthog

# ── Domain ──
POSTHOG_DOMAIN=ph.skatelab.ru
DOMAIN=skatelab.ru