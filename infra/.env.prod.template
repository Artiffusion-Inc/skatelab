# ============================================
# Infrastructure Environment Variables
# Copy to .env on server, fill secrets
# ============================================

# --- Docker / GHCR ---
TAG=latest
GHCR_OWNER=Artiffusion-Inc

# --- Database ---
POSTGRES_DB=skatelab
POSTGRES_USER=skatelab
POSTGRES_PASSWORD=change-me-32-chars-min
DATABASE_URL=postgresql+asyncpg://skatelab:change-me-32-chars-min@postgres:5432/skatelab

# --- Valkey (Task Queue) ---
VALKEY_URL=redis://valkey:6379/0

# --- Cloudflare R2 (Storage) ---
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<access-key-id>
R2_SECRET_ACCESS_KEY=<secret-access-key>
R2_BUCKET=skating-videos

# --- RustFS (S3-compatible, shared by SkateLab + PostHog) ---
RUSTFS_ACCESS_KEY_ID=<rustfs-access-key>
RUSTFS_SECRET_ACCESS_KEY=<rustfs-secret-key>
# Switch backend from R2 to RustFS:
# R2_ENDPOINT_URL=http://rustfs:9000
# R2_ACCESS_KEY_ID=<same-as-RUSTFS_ACCESS_KEY>
# R2_SECRET_ACCESS_KEY=<same-as-RUSTFS_SECRET_KEY>

# --- Auth ---
JWT_SECRET_KEY=change-me-64-chars-min-hex-or-random-string

# --- Vast.ai (Remote GPU) ---
# Leave empty to disable remote GPU (fallback local)
VASTAI_API_KEY=

# --- Logging ---
LOG_LEVEL=info

# --- Frontend ---
NEXT_PUBLIC_API_URL=/api

# --- PostHog ---
POSTHOG_APP_TAG=1.88.0
POSTHOG_NODE_TAG=1.88.0
POSTHOG_RUST_TAG=1.88.0
POSTHOG_SECRET_KEY=change-me-to-random-64-chars
POSTHOG_POSTGRES_PASSWORD=change-me-posthog-db-password
POSTHOG_ENCRYPTION_SALT_KEYS=
POSTHOG_API_KEY=
POSTHOG_HOST=https://ph.skatelab.ru
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://ph.skatelab.ru
POSTHOG_PERSONAL_API_KEY=

# --- Domain / TLS ---
DOMAIN=skatelab.ru
CLOUDFLARE_API_TOKEN=change-me-cloudflare-api-token-with-dns-edit-zone-read